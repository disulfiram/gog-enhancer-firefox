{
  "manifest_version": 3,
  "name": "GOG Enhancer",
  "version": "2026.10.0-alpha.1",
  "description": "Enhances the GOG store with additional game information and functionality.",
  "browser_specific_settings": {
    "gecko": {
      "id": "gog-enhancer@example.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "host_permissions": ["https://api.gog.com/*"],
  "background": {
    "scripts": ["dist/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://www.gog.com/*"],
      "js": ["dist/content/gogGamePage.js"],
      "run_at": "document_idle"
    }
  ]
}
